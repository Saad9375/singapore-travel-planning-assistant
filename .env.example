# Copy this file to .env and fill in your key
# Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza-your-key-here

# Model configuration (defaults shown)
# Free-tier quota is counted per model, so switching this gives a fresh daily allowance.
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# Silence chromadb telemetry (posthog 7.x signature mismatch)
ANONYMIZED_TELEMETRY=False
